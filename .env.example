# Copy to .env and fill in. Never commit .env.
TOFU_INVITE_CODE=changeme
TOFU_SOAP_URL=http://127.0.0.1:7878/
TOFU_SOAP_USER=changeme
TOFU_SOAP_PASS=changeme
TOFU_INVITE_MAX_FAILS=5
TOFU_CREATES_PER_HOUR=10
# 1 shows the raw SOAP response on the page. Use only while capturing response strings, never with friends.
TOFU_DEBUG=0
